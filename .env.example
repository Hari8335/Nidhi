# Local development placeholders only. Copy to ignored .env and replace these values.
POSTGRES_DB=nidhi_dev
POSTGRES_USER=nidhi_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPMENT_PASSWORD
POSTGRES_PORT=5432
# ASP.NET Core does not load .env; configure ConnectionStrings__NidhiDb separately.
# Next.js: export these in the frontend terminal, or use frontend/web/.env.local.
# Server-side rewrite target; keeps browser cookies on the frontend origin.
API_BASE_URL=http://localhost:5050
NEXT_PUBLIC_API_BASE_URL=/api/v1
